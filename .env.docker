# ============================================
# GameArt AI - Docker 部署环境变量
# 复制此文件为 .env.docker 后启动
#   cp .env.docker.example .env.docker
#   docker compose up -d
# ============================================

# --- PostgreSQL 数据库 ---
POSTGRES_USER=gameart
POSTGRES_PASSWORD=gameart123
POSTGRES_DB=game_art_ai

# --- 后端配置 ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=gameart
DB_PASSWORD=gameart123
DB_NAME=game_art_ai
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- 前端配置 ---
# NEXT_PUBLIC_API_URL 是浏览器端访问后端的地址
# 本地开发: http://localhost:8000
# 服务器部署: http://<服务器IP>:8000 或你的域名
NEXT_PUBLIC_API_URL=http://localhost:8000
