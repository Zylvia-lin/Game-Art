# ============================================
# GameArt AI Backend - Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# --- PostgreSQL Database ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=gameart
DB_PASSWORD=gameart123
DB_NAME=game_art_ai

# --- File Storage ---
# Absolute or relative path for uploaded files
UPLOAD_DIR=./uploads
# Max upload file size in bytes (default: 10MB)
MAX_UPLOAD_SIZE=10485760

# --- Server ---
BACKEND_PORT=8000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5000
